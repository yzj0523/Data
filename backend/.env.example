AI_ENVIRONMENT=development
AI_HOST=127.0.0.1
AI_PORT=8000
AI_LOG_LEVEL=info
AI_DATABASE_PATH=data/ai_query.sqlite3

# Optional. Configuration alone does not prove model connectivity.
AI_DEFAULT_MODEL_BASE_URL=
AI_DEFAULT_MODEL_NAME=
AI_DEFAULT_MODEL_API_KEY=
# Optional Fernet key. Otherwise a key is created next to the database on first use.
# AI_MODEL_ENCRYPTION_KEY=
